# ============================================================
#  FIFA 2026 Shorts Bot — Environment Configuration Template
#  Copy this file to .env and fill in your credentials
# ============================================================

# ── YouTube Data API v3 ──────────────────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
# Channel to upload to (leave blank for authenticated user's default channel)
YOUTUBE_CHANNEL_ID=

# ── Instagram Graph API ──────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
# Required for video uploads (must be publicly accessible URL)
INSTAGRAM_MEDIA_HOST_URL=https://your-server.com/media/

# ── OpenAI (for AI captions / titles) ───────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── Anthropic Claude (alternative AI) ───────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Content Sources ──────────────────────────────────────────
# Comma-separated YouTube channel IDs to monitor for FIFA highlights
YOUTUBE_SOURCE_CHANNELS=UCpcTrCXblq78GZrTUTLWeBw,UC8-cU4aHHADFtCmSHQKMh0g
# Comma-separated hashtags to monitor on Instagram
INSTAGRAM_HASHTAGS=FIFA2026,WorldCup2026,WorldCup

# ── Scheduler ────────────────────────────────────────────────
# How often to check for new content (minutes)
CRAWL_INTERVAL_MINUTES=30
# How many shorts to produce per crawl run
MAX_SHORTS_PER_RUN=3
# Time zone for scheduling (e.g. America/New_York, Asia/Kolkata)
TIMEZONE=UTC

# ── Video Settings ───────────────────────────────────────────
# Max source clip length to download (seconds). Longer clips are trimmed.
MAX_SOURCE_DURATION=300
# Target short duration in seconds (YouTube Shorts max = 60, Reels max = 90)
SHORT_DURATION=58
# Output resolution: 1080x1920 for portrait shorts
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# ── Music ────────────────────────────────────────────────────
# Volume of background music relative to original audio (0.0 – 1.0)
MUSIC_VOLUME=0.15
# Directory containing royalty-free .mp3 files
MUSIC_DIR=assets/music

# ── Paths ────────────────────────────────────────────────────
DOWNLOAD_DIR=output/downloads
EDITED_DIR=output/edited
THUMBNAIL_DIR=output/thumbnails
LOG_DIR=logs

# ── Feature Flags ────────────────────────────────────────────
ENABLE_YOUTUBE_UPLOAD=true
ENABLE_INSTAGRAM_UPLOAD=true
ENABLE_AI_CAPTIONS=true
DRY_RUN=false

# ── ZEE5 Integration (India-focused) ────────────────────
# Your ZEE5 email and password for auto-login
ZEE5_EMAIL=your_zee5_email@gmail.com
ZEE5_PASSWORD=your_zee5_password
# Enable crawling FIFA content from ZEE5
ENABLE_ZEE5_CRAWL=true
# Upload shorts back to ZEE5 (requires API access)
ENABLE_ZEE5_UPLOAD=false
